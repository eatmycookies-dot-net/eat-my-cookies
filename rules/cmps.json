{
  "version": "1.1.0",
  "cmps": [
    {
      "id": "hubspotcookiebanner",
      "name": "HubSpot Cookie Banner",
      "detectors": [
        { "type": "css_selector", "value": "#hs-eu-cookie-confirmation" },
        { "type": "css_selector", "value": "#hs-eu-cookie-settings-button" },
        { "type": "css_selector", "value": "#hs-eu-confirmation-button" },
        { "type": "css_selector", "value": "#hs-eu-decline-button" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#hs-eu-decline-button" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#hs-eu-confirmation-button" }
        ]
      }
    },
    {
      "id": "globolgpd",
      "name": "Globo LGPD Banner",
      "notice_only": true,
      "detectors": [
        { "type": "css_selector", "value": "#cookie-banner-lgpd" },
        { "type": "css_selector", "value": ".cookie-banner-lgpd-visible" },
        { "type": "css_selector", "value": ".cookie-banner-lgpd_accept-button" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".cookie-banner-lgpd_accept-button" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".cookie-banner-lgpd_accept-button" }
        ]
      }
    },
    {
      "id": "sbtlgpd",
      "name": "SBT LGPD Banner",
      "notice_only": true,
      "detectors": [
        { "type": "css_selector", "value": "div[class*='cookiesBanner__'][class*='visible']" },
        { "type": "css_selector", "value": "div[class*='fixed'][class*='pointer-events-auto'] a.font-bold.underline.text-brand-color[href='https://www.sbt.com.br/politica-de-privacidade']" },
        { "type": "css_selector", "value": "div[class*='fixed'][class*='pointer-events-auto'] button[class*='bg-brand-color']" },
        { "type": "css_selector", "value": "a[class*='cookiesBannerLink']" },
        { "type": "css_selector", "value": "button.sbt-button" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "button.sbt-button" }
        ],
        "accept_all": [
          { "type": "click", "selector": "button.sbt-button" }
        ]
      }
    },
    {
      "id": "xplgpd",
      "name": "XP LGPD Banner",
      "detectors": [
        { "type": "css_selector", "value": "[data-testid='lgpd-cookies-id']" },
        { "type": "css_selector", "value": "#cookies-policy-container" },
        { "type": "css_selector", "value": "cookies-policy" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "button[aria-label*='rejeitar todos os cookies' i]" },
          { "type": "click", "selector": "button[aria-label*='rejeitar cookies' i]" }
        ],
        "accept_all": [
          { "type": "click", "selector": "button[aria-label*='aceitar todos os cookies' i]" },
          { "type": "click", "selector": "button[aria-label*='aceitar cookies' i]" }
        ]
      }
    },
    {
      "id": "privacytoolsbanner",
      "name": "Privacy Tools Banner",
      "note": "Brazilian storefronts such as Americanas use a lightweight Privacy Tools cookie banner with an accept button plus a close affordance but no explicit reject-all path.",
      "detectors": [
        { "type": "script_src", "value": "privacytools.com.br" },
        { "type": "css_selector", "value": "#privacytools-banner-consent" },
        { "type": "css_selector", "value": ".cc-window.cc-banner" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#privacytools-banner-consent .cc-close" },
          { "type": "click", "selector": ".cc-window.cc-banner .cc-close" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#privacytools-banner-consent .cc-btn.cc-dismiss" },
          { "type": "click", "selector": ".cc-window.cc-banner .cc-btn.cc-dismiss" }
        ]
      }
    },
    {
      "id": "bradescolgpd",
      "name": "Bradesco LGPD Banner",
      "detectors": [
        { "type": "css_selector", "value": "#cookies.cookie-banner" },
        { "type": "css_selector", "value": "#rejeitarCookiesNaoNecessarios" },
        { "type": "css_selector", "value": "#aceitarCookies" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#rejeitarCookiesNaoNecessarios" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#aceitarCookies" }
        ]
      }
    },
    {
      "id": "netshoescookie",
      "name": "Netshoes Cookie Notice",
      "notice_only": true,
      "note": "Netshoes currently exposes an informational cookie notice with a single agree-and-close action.",
      "detectors": [
        { "type": "css_selector", "value": ".cookie-notification" },
        { "type": "css_selector", "value": ".cookie-notification__content__button" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".cookie-notification__content__button" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".cookie-notification__content__button" }
        ]
      }
    },
    {
      "id": "govbrcookiebar",
      "name": "gov.br Cookie Bar",
      "note": "Brazil government properties expose a shared LGPD cookie bar with explicit accept, reject, and manage actions.",
      "detectors": [
        { "type": "css_selector", "value": ".br-cookiebar" },
        { "type": "css_selector", "value": ".btn-accept" },
        { "type": "css_selector", "value": ".reject-all" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".br-cookiebar .reject-all" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".br-cookiebar .btn-accept" }
        ]
      }
    },
    {
      "id": "spgovlgpd",
      "name": "Sao Paulo State LGPD Banner",
      "notice_only": true,
      "note": "The SP state portal currently shows an accept-only essential-cookies notice inside #lgpdModal.",
      "detectors": [
        { "type": "css_selector", "value": "#lgpdModal" },
        { "type": "css_selector", "value": "#cadastrar.lgpd-btn" },
        { "type": "css_selector", "value": ".lgpd-modal.show" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#cadastrar.lgpd-btn" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#cadastrar.lgpd-btn" }
        ]
      }
    },
    {
      "id": "correioscookie",
      "name": "Correios Cookie Notice",
      "notice_only": true,
      "note": "Correios exposes a lightweight accept-only statistics cookie notice.",
      "detectors": [
        { "type": "css_selector", "value": "#cookiesId" },
        { "type": "css_selector", "value": ".cookiesCorreios" },
        { "type": "css_selector", "value": ".cookiesBotaoAceitar #btnCookie" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".cookiesBotaoAceitar #btnCookie" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".cookiesBotaoAceitar #btnCookie" }
        ]
      }
    },
    {
      "id": "radiocanadacookie",
      "name": "Radio-Canada Cookie Alert",
      "notice_only": true,
      "note": "Radio-Canada currently exposes an accept-and-close privacy alert tied to the RC_NOTIFICATION_VIE_PRIVEE cookie.",
      "detectors": [
        { "type": "css_selector", "value": "#js-legal-disclaimer" },
        { "type": "css_selector", "value": ".g-alert-cookie" },
        { "type": "css_selector", "value": "button[title*=\"Accepter et fermer l'alerte\" i]" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "button[title*=\"Accepter et fermer l'alerte\" i]" }
        ],
        "accept_all": [
          { "type": "click", "selector": "button[title*=\"Accepter et fermer l'alerte\" i]" }
        ]
      }
    },
    {
      "id": "sourcepoint",
      "name": "Sourcepoint",
      "note": "Sourcepoint renders its UI inside a cross-origin iframe. Detection here is for reporting only — the actual click happens in sp-frame-handler.js which runs with all_frames:true.",
      "detectors": [
        { "type": "css_selector", "value": "[id^='sp_message_container']" },
        { "type": "css_selector", "value": "[id^='sp_message_iframe']" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".sp_choice_type_REJECT_ALL" },
          { "type": "click", "selector": ".sp_choice_type_11" },
          { "type": "click", "selector": ".sp_choice_type_13" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".sp_choice_type_ACCEPT_ALL" },
          { "type": "click", "selector": ".sp_choice_type_13" },
          { "type": "click", "selector": ".sp_choice_type_11" }
        ]
      }
    },
    {
      "id": "onetrust",
      "name": "OneTrust",
      "detectors": [
        { "type": "js_global",    "value": "window.OneTrust" },
        { "type": "css_selector", "value": "#onetrust-banner-sdk" },
        { "type": "css_selector", "value": "#onetrust-consent-sdk" },
        { "type": "css_selector", "value": "#onetrust-pc-sdk" },
        { "type": "css_selector", "value": ".onetrust-pc-dark-filter" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#onetrust-reject-all-handler" },
          { "type": "click", "selector": ".ot-pc-refuse-all-handler" },
          { "type": "click", "selector": "button[aria-label*='Reject']" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#onetrust-accept-btn-handler" }
        ],
        "customize": {
          "open": { "type": "click", "selector": "#onetrust-pc-btn-handler" },
          "save":  { "type": "click", "selector": "#onetrust-accept-btn-handler" }
        }
      }
    },
    {
      "id": "cookiebot",
      "name": "Cookiebot",
      "detectors": [
        { "type": "js_global",    "value": "window.Cookiebot" },
        { "type": "css_selector", "value": "#CybotCookiebotDialog" },
        { "type": "css_selector", "value": "#cookiebanner" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#CybotCookiebotDialogBodyButtonDecline" },
          { "type": "click", "selector": "#CybotCookiebotDialogBodyLevelButtonLevelOptinDeclineAll" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#CybotCookiebotDialogBodyLevelButtonLevelOptinAllowAll" },
          { "type": "click", "selector": "#CybotCookiebotDialogBodyButtonAccept" }
        ]
      }
    },
    {
      "id": "investiscookiemanager",
      "name": "Investis Cookie Manager",
      "detectors": [
        { "type": "script_src",    "value": "assets.investisdigital.com/cookiemanager" },
        { "type": "script_src",    "value": "cookiemanager.investisdigital.com" },
        { "type": "css_selector", "value": "#__cookieWrapper" },
        { "type": "css_selector", "value": "#cc-reject-Btn" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#cc-reject-Btn" },
          { "type": "click", "selector": "#cc-reject-Btn-modal" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#cc-acceptAll-btn" },
          { "type": "click", "selector": "#cc-acceptAll-btn-modal" }
        ]
      }
    },
    {
      "id": "didomi",
      "name": "Didomi",
      "detectors": [
        { "type": "script_src",    "value": "sdk.privacy-center.org" },
        { "type": "script_src",    "value": "didomi.io" },
        { "type": "js_global",    "value": "window.Didomi" },
        { "type": "css_selector", "value": "#didomi-popup" },
        { "type": "css_selector", "value": "#didomi-notice" },
        { "type": "css_selector", "value": "#didomi-consent-popup" },
        { "type": "css_selector", "value": ".didomi-consent-popup__dialog" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#didomi-notice-disagree-button" },
          { "type": "click", "selector": ".didomi-notice-disagree-button" },
          { "type": "click", "selector": "[data-didomi-action='disagree']" },
          { "type": "click", "selector": "[didomi-notice-action='disagree']" },
          { "type": "click", "selector": "#btn-toggle-disagree" },
          { "type": "click", "selector": ".didomi-components-button--ghost:not([aria-label*='all' i])" },
          { "type": "click", "selector": "button[aria-label*='Reject' i]" },
          { "type": "click", "selector": "button[aria-label*='Refuser' i]" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#didomi-notice-agree-button" },
          { "type": "click", "selector": ".didomi-notice-agree-button" },
          { "type": "click", "selector": "[data-didomi-action='agree']" },
          { "type": "click", "selector": "#btn-toggle-agree" }
        ]
      }
    },
    {
      "id": "usercentrics",
      "name": "Usercentrics",
      "detectors": [
        { "type": "js_global",    "value": "window.UC_UI" },
        { "type": "css_selector", "value": "#usercentrics-cmp-ui" },
        { "type": "css_selector", "value": "#usercentrics-root" },
        { "type": "css_selector", "value": "[data-testid='uc-banner']" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "[data-action-type='deny']" },
          { "type": "click", "selector": "[data-action-type='reject']" },
          { "type": "click", "selector": "[data-testid='uc-deny-all-button']" },
          { "type": "click", "selector": "button[aria-label*='Deny']" }
        ],
        "accept_all": [
          { "type": "click", "selector": "[data-action-type='accept']" },
          { "type": "click", "selector": "[data-testid='uc-accept-all-button']" }
        ]
      }
    },
    {
      "id": "quantcast",
      "name": "Quantcast Choice",
      "detectors": [
        { "type": "js_global",    "value": "window.__cmp" },
        { "type": "css_selector", "value": ".qc-cmp2-container" },
        { "type": "css_selector", "value": "#qc-cmp2-ui" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".qc-cmp2-summary-buttons button:first-child" },
          { "type": "click", "selector": "button[mode='secondary']" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".qc-cmp2-summary-buttons button:last-child" }
        ]
      }
    },
    {
      "id": "trustarc",
      "name": "TrustArc",
      "detectors": [
        { "type": "js_global",    "value": "window.truste" },
        { "type": "css_selector", "value": "#truste-consent-track" },
        { "type": "css_selector", "value": ".truste_overlay" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#truste-consent-required" },
          { "type": "click", "selector": ".truste-option-button:first-child" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#truste-consent-button" }
        ]
      }
    },
    {
      "id": "axeptio",
      "name": "Axeptio",
      "detectors": [
        { "type": "js_global",    "value": "window._axcb" },
        { "type": "css_selector", "value": "#axeptio_overlay" },
        { "type": "css_selector", "value": ".axeptio_widget" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".axeptio-btn--close" },
          { "type": "click", "selector": "[data-test='dismiss']" }
        ],
        "accept_all": [
          { "type": "click", "selector": "[data-test='accept-all-cookies']" }
        ]
      }
    },
    {
      "id": "complianz",
      "name": "Complianz",
      "note": "Complianz can expose a simple banner or a preferences drawer with category toggles.",
      "detectors": [
        { "type": "css_selector", "value": "#cmplz-cookiebanner-container" },
        { "type": "css_selector", "value": ".cmplz-cookiebanner" },
        { "type": "css_selector", "value": ".cmplz-view-preferences" },
        { "type": "css_selector", "value": ".cmplz-save-preferences" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".cmplz-btn.cmplz-deny" },
          { "type": "click", "selector": ".cmplz-deny" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".cmplz-btn.cmplz-accept" },
          { "type": "click", "selector": ".cmplz-accept" }
        ]
      }
    },
    {
      "id": "borlabs",
      "name": "Borlabs Cookie",
      "note": "Borlabs usually needs the preferences panel for reliable non-accept flows.",
      "detectors": [
        { "type": "css_selector", "value": "#BorlabsCookieBox" },
        { "type": "css_selector", "value": ".show-cookie-box" },
        { "type": "css_selector", "value": "#CookiePrefSave" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".cookie-box ._brlbs-btn-accept-only-essential" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".cookie-box ._brlbs-btn-accept-all" }
        ]
      }
    },
    {
      "id": "cookieinformation",
      "name": "Cookie Information",
      "note": "Cookie Information often renders a summary banner that opens into a toggle-based preferences page.",
      "detectors": [
        { "type": "css_selector", "value": "#coiOverlay" },
        { "type": "css_selector", "value": "#ccb-coiOverlay" },
        { "type": "css_selector", "value": "#coiConsentBanner" },
        { "type": "css_selector", "value": "#ccb-coiConsentBanner" },
        { "type": "css_selector", "value": "#coi-banner-wrapper" },
        { "type": "css_selector", "value": "#ccb-coi-banner-wrapper" },
        { "type": "css_selector", "value": ".coi-consent-summary" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#ccb-coiConsentBanner #ccb-declineButton" },
          { "type": "click", "selector": "#ccb-coiOverlay #ccb-declineButton" },
          { "type": "click", "selector": "#ccb-declineButton" },
          { "type": "click", "selector": "#coiConsentBanner #declineButton" },
          { "type": "click", "selector": "#coiOverlay #declineButton" },
          { "type": "click", "selector": "#declineButton" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#ccb-coiOverlay button.coi-banner__accept" },
          { "type": "click", "selector": "#ccb-coiConsentBanner .bottom-bar__update-consent" },
          { "type": "click", "selector": "#ccb-coiConsentBanner #ccb-updateButton" },
          { "type": "click", "selector": "#ccb-coiOverlay #ccb-updateButton" },
          { "type": "click", "selector": "#ccb-updateButton" },
          { "type": "click", "selector": "#coiOverlay button.coi-banner__accept" },
          { "type": "click", "selector": "#coiConsentBanner .bottom-bar__update-consent" },
          { "type": "click", "selector": "#coiConsentBanner #updateButton" },
          { "type": "click", "selector": "#coiOverlay #updateButton" },
          { "type": "click", "selector": "#updateButton" }
        ]
      }
    },
    {
      "id": "cookiewow",
      "name": "Cookie Wow",
      "note": "Cookie Wow exposes per-category switches behind a settings button.",
      "detectors": [
        { "type": "css_selector", "value": ".cwc-banner-container" },
        { "type": "css_selector", "value": ".cwc-consent-summary-container" },
        { "type": "css_selector", "value": ".cwc-setting-button" },
        { "type": "css_selector", "value": ".cwc-save-setting-wrapper button" }
      ],
      "actions": {
        "accept_all": [
          { "type": "click", "selector": ".cwc-accept-button" }
        ]
      }
    },
    {
      "id": "glowcookies",
      "name": "GlowCookies",
      "detectors": [
        { "type": "css_selector", "value": "#glowCookies-banner" },
        { "type": "css_selector", "value": ".glowCookies__banner" },
        { "type": "css_selector", "value": "#acceptCookies" },
        { "type": "css_selector", "value": "#rejectCookies" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#rejectCookies" },
          { "type": "click", "selector": "button#rejectCookies" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#acceptCookies" },
          { "type": "click", "selector": "button#acceptCookies" }
        ]
      }
    },
    {
      "id": "cookiecontrolcivic",
      "name": "Cookie Control by Civic",
      "note": "Cookie Control can render either a compact notify banner or a full preference dialog with category-level toggles.",
      "detectors": [
        { "type": "css_selector", "value": "#ccc-notify .ccc-notify-button" },
        { "type": "css_selector", "value": "#ccc-content" },
        { "type": "css_selector", "value": "#ccc[open]" }
      ],
      "actions": {
        "accept_all": [
          { "type": "click", "selector": "#ccc-recommended-settings" }
        ]
      }
    },
    {
      "id": "cookieyes",
      "name": "CookieYes",
      "detectors": [
        { "type": "css_selector", "value": "#cookie-law-info-bar" },
        { "type": "css_selector", "value": ".cky-banner-element" },
        { "type": "css_selector", "value": "#cky-consent-handler" },
        { "type": "css_selector", "value": ".cky-consent-container" },
        { "type": "css_selector", "value": ".cky-btn-customize" },
        { "type": "css_selector", "value": "button[data-cky-tag='settings-button']" }
