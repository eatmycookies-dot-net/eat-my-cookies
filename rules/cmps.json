      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".wpgdprc-consent-bar__settings" },
          { "type": "click", "selector": ".wpgdprc-button" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".wpgdprc-consent-bar__button" },
          { "type": "click", "selector": ".wpgdprc-button" }
        ]
      }
    },
    {
      "id": "woocommercestorenotice",
      "name": "WooCommerce Store Notice",
      "note": "Not a full CMP, but a common ecommerce storefront notice that blocks content until dismissed.",
      "detectors": [
        { "type": "css_selector", "value": ".woocommerce-store-notice" },
        { "type": "css_selector", "value": ".woocommerce-store-notice__dismiss-link" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".woocommerce-store-notice__dismiss-link" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".woocommerce-store-notice__dismiss-link" }
        ]
      }
    },
    {
      "id": "magentocookie",
      "name": "Magento Cookie Notice",
      "note": "Magento storefronts often render a lightweight cookie restriction notice rather than a full CMP. When a reject path exists we use it; otherwise we close the notice.",
      "detectors": [
        { "type": "css_selector", "value": ".message.global.cookie" },
        { "type": "css_selector", "value": ".cookie.message" },
        { "type": "css_selector", "value": "[data-role='cookie-settings']" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".message.global.cookie .action.close" },
          { "type": "click", "selector": ".cookie.message .action.close" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".message.global.cookie .action.allow" },
          { "type": "click", "selector": ".message.global.cookie .action.accept" },
          { "type": "click", "selector": ".cookie.message .action.allow" },
          { "type": "click", "selector": ".cookie.message .action.accept" }
        ]
      }
    },
    {
      "id": "pandectes",
      "name": "Pandectes GDPR Compliance",
      "note": "Pandectes exposes a CookieConsent-style banner with a first-party preferences modal and category toggles.",
      "detectors": [
        { "type": "css_selector", "value": "#pandectes-banner" },
        { "type": "css_selector", "value": ".pd-cookie-banner-window" },
        { "type": "css_selector", "value": "#pd-cp-preferences" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".cc-btn.cc-deny" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".cc-btn.cc-allow" }
        ]
      }
    },
    {
      "id": "consentmo",
      "name": "Consentmo GDPR Compliance",
      "note": "Consentmo often renders inside a csm-cookie-consent custom element with an open shadow root and CookieConsent-style controls.",
      "detectors": [
        { "type": "css_selector", "value": "csm-cookie-consent" }
      ],
      "actions": {
        "reject_all": [
          { "type": "wait", "selector": "csm-cookie-consent" }
        ],
        "accept_all": [
          { "type": "wait", "selector": "csm-cookie-consent" }
        ]
      }
    },
    {
      "id": "bigcommercecatalyst",
      "name": "BigCommerce Catalyst",
      "note": "Catalyst storefronts expose a same-origin storefront consent API and render a c15t-powered consent dialog. We persist category choices through the API and only use the DOM for safe dismissal.",
      "detectors": [
        { "type": "css_selector", "value": "meta[name='platform'][content='bigcommerce.catalyst']" }
      ],
      "actions": {
        "reject_all": [
          { "type": "wait", "selector": "meta[name='platform'][content='bigcommerce.catalyst']" }
        ],
        "accept_all": [
          { "type": "wait", "selector": "meta[name='platform'][content='bigcommerce.catalyst']" }
        ]
      }
    },
    {
      "id": "termly",
      "name": "Termly",
      "detectors": [
        { "type": "css_selector", "value": "[id^='termly-code']" },
        { "type": "css_selector", "value": ".termly-styles-module" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "[data-tid='banner-decline']" }
        ],
        "accept_all": [
          { "type": "click", "selector": "[data-tid='banner-accept']" }
        ]
      }
    },
    {
      "id": "truendo",
      "name": "Truendo",
      "detectors": [
        { "type": "css_selector", "value": "#truendo_container div[class*='tru_cookie-dialog']" },
        { "type": "css_selector", "value": "#truendo_container #tru_options_btn" },
        { "type": "css_selector", "value": "#truendo_container [data-cy='action-button-save']" },
        { "type": "css_selector", "value": "#truendo_container #truendo_fab" },
        { "type": "css_selector", "value": "#truendo_container [data-cy='tru-fab']" }
      ],
      "actions": {
        "accept_all": [
          { "type": "click", "selector": "#truendo_container [data-cy='action-button-accept']" }
        ],
        "reject_all": [
          { "type": "click", "selector": "#truendo_container [data-cy='action-button-reject']" },
          { "type": "click", "selector": "#truendo_container .tru-reject-btn" }
        ]
      }
    },
    {
      "id": "iubenda",
      "name": "Iubenda",
      "detectors": [
        { "type": "js_global",    "value": "window._iub" },
        { "type": "css_selector", "value": "#iubenda-cs-banner" },
        { "type": "css_selector", "value": ".iubenda-cs-content" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".iubenda-cs-reject-btn" },
          { "type": "click", "selector": "[class*='iubenda-cs-reject']" },
          { "type": "click", "selector": "#iubenda-cs-decline" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".iubenda-cs-accept-btn" },
          { "type": "click", "selector": "#iubenda-cs-accept" }
        ]
      }
    },
    {
      "id": "cookiescript",
      "name": "CookieScript",
      "detectors": [
        { "type": "js_global",    "value": "window.CookieScript" },
        { "type": "css_selector", "value": "#cookiescript_injected" },
        { "type": "css_selector", "value": "#cookiescript_injected_wrapper" },
        { "type": "css_selector", "value": "#cookiescript_accept" },
        { "type": "css_selector", "value": "#cookiescript_reject" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#cookiescript_reject" },
          { "type": "click", "selector": "#cookiescript_save" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#cookiescript_accept" },
          { "type": "click", "selector": "#cookiescript_save" }
        ]
      }
    },
    {
      "id": "osano",
      "name": "Osano",
      "note": "Osano can render either a simple banner or an expanded preference drawer with category toggles and a Save action.",
      "detectors": [
        { "type": "css_selector", "value": ".osano-cm-dialog" },
        { "type": "css_selector", "value": ".osano-cm-window" },
        { "type": "css_selector", "value": ".osano-cm-widget" },
        { "type": "css_selector", "value": "button.osano-cm-save" },
        { "type": "css_selector", "value": "button.osano-cm-denyAll" },
        { "type": "css_selector", "value": "button.osano-cm-accept-all" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "button.osano-cm-denyAll" },
          { "type": "click", "selector": ".osano-cm-denyAll" }
        ],
        "accept_all": [
          { "type": "click", "selector": "button.osano-cm-accept-all" },
          { "type": "click", "selector": ".osano-cm-accept-all" }
        ],
        "customize": {
          "open": { "type": "click", "selector": ".osano-cm-link--type_manage" },
          "save": { "type": "click", "selector": "button.osano-cm-save" }
        }
      }
    },
    {
      "id": "consentmanager",
      "name": "ConsentManager",
      "note": "Used by DW. Banner injects into #cmpwrapper in the main frame.",
      "detectors": [
        { "type": "css_selector", "value": "#cmpbox" },
        { "type": "css_selector", "value": "#cmpwrapper" },
        { "type": "css_selector", "value": ".cmpboxbtns" },
        { "type": "css_selector", "value": ".cmpboxbtnno" },
        { "type": "css_selector", "value": "#cmpbntnotxt" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".cmpboxbtnno" },
          { "type": "click", "selector": "#cmpbntnotxt" },
          { "type": "click", "selector": "a[data-cmp-action='rejectall']" },
          { "type": "click", "selector": "a[onclick*='setNecessary']" },
          { "type": "click", "selector": "button[title*='Reject' i]" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".cmpboxbtnyes" },
          { "type": "click", "selector": "#cmpbntyestxt" },
          { "type": "click", "selector": "a[data-cmp-action='acceptall']" }
        ]
      }
    },
    {
      "id": "lemonde",
      "name": "Le Monde (custom)",
      "note": "Le Monde uses a custom GDPR consent wall with proprietary CSS classes.",
      "detectors": [
        { "type": "css_selector", "value": ".gdpr-lmd-wall" },
        { "type": "css_selector", "value": "[data-gdpr-expression='acceptAll']" },
        { "type": "css_selector", "value": "[data-gdpr-expression='denyAll']" },
        { "type": "css_selector", "value": "[data-gdpr-action='settings']" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "[data-gdpr-expression='denyAll']" },
          { "type": "click", "selector": ".gdpr-lmd-wall__refuse-link" },
          { "type": "click", "selector": "button[data-gdpr-expression='denyAll']" }
        ],
        "accept_all": [
          { "type": "click", "selector": "[data-gdpr-expression='acceptAll']" },
          { "type": "click", "selector": ".gdpr-lmd-button--main" },
          { "type": "click", "selector": ".gdpr-lmd-button" }
        ]
      }
    },
    {
      "id": "shopify",
      "name": "Shopify Customer Privacy",
      "note": "Shopify's native customer privacy banner can appear as a simple banner or a granular preferences dialog.",
      "detectors": [
        { "type": "css_selector", "value": "#shopify-pc__banner" },
        { "type": "css_selector", "value": ".shopify-pc__banner__dialog" },
        { "type": "css_selector", "value": "#shopify-pc__prefs__dialog" },
        { "type": "css_selector", "value": "#privacy-cookie-banner" },
        { "type": "css_selector", "value": "#privacy-preferences-modal" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": "#shopify-pc__banner__btn-decline" },
          { "type": "click", "selector": "#shopify-pc__prefs__header-decline" },
          { "type": "click", "selector": "button.shopify-pc__banner__btn-decline" },
          { "type": "click", "selector": "#privacy-banner-decline-button" },
          { "type": "click", "selector": "#privacy-preferences-decline-all-button" }
        ],
        "accept_all": [
          { "type": "click", "selector": "#shopify-pc__banner__btn-accept" },
          { "type": "click", "selector": "#shopify-pc__prefs__header-accept" },
          { "type": "click", "selector": "button.shopify-pc__banner__btn-accept" },
          { "type": "click", "selector": "#privacy-banner-accept-button" },
          { "type": "click", "selector": "#privacy-preferences-accept-all-button" }
        ]
      }
    },
    {
      "id": "klaro",
      "name": "Klaro",
      "detectors": [
        { "type": "js_global",    "value": "window.klaro" },
        { "type": "css_selector", "value": ".klaro .cookie-modal" },
        { "type": "css_selector", "value": ".klaro .cookie-notice" }
      ],
      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".klaro .cn-decline" },
          { "type": "click", "selector": "button[data-testid='klaro-decline']" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".klaro .cm-btn-success" },
          { "type": "click", "selector": ".klaro .cn-ok" }
        ]
      }
    },
    {
      "id": "clickio",
      "name": "Clickio",
      "detectors": [
        { "type": "css_selector", "value": "#cl-consent" },
        { "type": "css_selector", "value": ".cl-consent__inner" },
        { "type": "css_selector", "value": ".cl-consent__btn--outline" }
      ],
      "actions": {
        "accept_all": [
          { "type": "click", "selector": ".cl-consent__btn:not(.cl-consent__btn--outline)" },
          { "type": "click", "selector": ".cl-consent__btn--primary" }
        ]
      }
    },
    {
      "id": "cookiesjsr",
      "name": "cookiesjsr",
      "detectors": [
        { "type": "css_selector", "value": "#cookiesjsr" },
        { "type": "css_selector", "value": ".cookiesjsr--app" },
        { "type": "css_selector", "value": ".cookiesjsr-settings" }
      ],
      "actions": {
        "accept_all": [
          { "type": "click", "selector": ".cookiesjsr-btn.allowAll" },
          { "type": "click", "selector": ".cookiesjsr-layer--actions .allow-all" }
        ]
      }
    },
    {
      "id": "privacymanager",
      "name": "privacymanager.io",
      "detectors": [
        { "type": "css_selector", "value": ".notice-title" },
        { "type": "css_selector", "value": "#manageSettings" },
        { "type": "css_selector", "value": "#saveAndExit" },
        { "type": "css_selector", "value": ".banner-lgpd-consent" },
        { "type": "css_selector", "value": ".banner-lgpd-consent__accept" },
        { "type": "css_selector", "value": "dialog.push-notification.is-cookies" },
        { "type": "css_selector", "value": ".push-notification--accept-button" },
        { "type": "css_selector", "value": "#cookie-banner" },
        { "type": "css_selector", "value": "#adopt-accept-all-button" },
        { "type": "css_selector", "value": "#adopt-preferences-button" }
      ],
      "actions": {
        "accept_all": [
          { "type": "click", "selector": "#saveAndExit" }
        ]
      }
    },
    {
      "id": "godaddyprivacy",
      "name": "GoDaddy Privacy Manager",
      "detectors": [
        { "type": "css_selector", "value": "#gtm_privacy" }
      ]
    }
  ]
