      "actions": {
        "reject_all": [
          { "type": "click", "selector": ".cky-btn-reject" },
          { "type": "click", "selector": "#cookie_action_close_header_reject" }
        ],
        "accept_all": [
          { "type": "click", "selector": ".cky-btn-accept" },
          { "type": "click", "selector": "#cookie_action_close_header" }
        ]
      }
    },
    {
      "id": "wordpressgdpr",
      "name": "WordPress GDPR",
      "note": "The older WordPress GDPR plugin exposes a banner plus a modal with per-category checkboxes and a Save action.",
      "detectors": [
        { "type": "css_selector", "value": ".wpgdprc-consent-bar" },
        { "type": "css_selector", "value": ".wpgdprc-consent-modal" },
        { "type": "css_selector", "value": ".wpgdprc-consent-bar__settings" }
